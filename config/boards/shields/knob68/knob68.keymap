#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define FN      1
#define NUMPAD  2

// SpaceFn: tap space = space, hold space = FN layer. "balanced" decides hold as
// soon as another key is pressed and released; quick-tap keeps space repeating
// on fast double-taps instead of misfiring into the layer.
&lt {
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        td0: tap_dance_end_home {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp END>, <&kp HOME>;
        };

        // Leader key (urob/zmk-leader-key module): tap, then type a sequence.
        // RET = presses Enter.
        //   E E   -> types personal email address
        //   E R   -> types work email address
        //   G S   -> git status RET
        //   G C   -> git commit -m "" with the cursor inside the quotes
        //   G P   -> git pull RET
        //   C L   -> claude RET
        //   C C   -> claude --continue RET
        //   R E   -> types "claude --resume" (no Enter, for appending flags)
        //   P L   -> /plan RET
        //   A U   -> /auto RET
        //   T E   -> Win key, "terminal", Enter (opens Windows Terminal)
        //   1 1   -> sudo !! RET
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            emailp   { sequence = <E E>; bindings = <&email_macro>; };
            emailw   { sequence = <E R>; bindings = <&work_email_macro>; };
            gits     { sequence = <G S>; bindings = <&git_status_macro>; };
            gitc     { sequence = <G C>; bindings = <&git_commit_macro>; };
            gitp     { sequence = <G P>; bindings = <&git_pull_macro>; };
            claude   { sequence = <C L>; bindings = <&claude_macro>; };
            continue { sequence = <C C>; bindings = <&claude_continue_macro>; };
            resume   { sequence = <R E>; bindings = <&claude_resume_macro>; };
            plan     { sequence = <P L>; bindings = <&plan_macro>; };
            auto     { sequence = <A U>; bindings = <&auto_macro>; };
            terminal { sequence = <T E>; bindings = <&terminal_macro>; };
            sudobang { sequence = <N1 N1>; bindings = <&sudo_bang_macro>; };
        };
    };

    macros {
        email_macro: email_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp S &kp DOT &kp W &kp H &kp I &kp T &kp E
                        &kp N4 &kp N3 &kp N2 &kp AT
                        &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
        };
        work_email_macro: work_email_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp S &kp W &kp H &kp I &kp T &kp E &kp AT
                        &kp A &kp L &kp L &kp E &kp V &kp I &kp A
                        &kp R &kp A &kp D &kp I &kp O &kp L &kp O &kp G &kp Y
                        &kp DOT &kp C &kp O &kp DOT &kp N &kp Z>;
        };
        git_status_macro: git_status_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp G &kp I &kp T &kp SPACE
                        &kp S &kp T &kp A &kp T &kp U &kp S &kp RET>;
        };
        git_commit_macro: git_commit_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp G &kp I &kp T &kp SPACE
                        &kp C &kp O &kp M &kp M &kp I &kp T &kp SPACE
                        &kp MINUS &kp M &kp SPACE
                        &kp DQT &kp DQT &kp LEFT>;
        };
        git_pull_macro: git_pull_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp G &kp I &kp T &kp SPACE
                        &kp P &kp U &kp L &kp L &kp RET>;
        };
        claude_macro: claude_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp C &kp L &kp A &kp U &kp D &kp E &kp RET>;
        };
        claude_continue_macro: claude_continue_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp C &kp L &kp A &kp U &kp D &kp E &kp SPACE
                        &kp MINUS &kp MINUS
                        &kp C &kp O &kp N &kp T &kp I &kp N &kp U &kp E &kp RET>;
        };
        claude_resume_macro: claude_resume_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp C &kp L &kp A &kp U &kp D &kp E &kp SPACE
                        &kp MINUS &kp MINUS
                        &kp R &kp E &kp S &kp U &kp M &kp E>;
        };
        plan_macro: plan_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp FSLH &kp P &kp L &kp A &kp N &kp RET>;
        };
        auto_macro: auto_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp FSLH &kp A &kp U &kp T &kp O &kp RET>;
        };
        terminal_macro: terminal_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <5>;
            // Win key, pause for the Start menu, type "terminal", pause for
            // search results, Enter.
            bindings = <&macro_wait_time 400 &kp LGUI
                        &macro_wait_time 10
                        &kp T &kp E &kp R &kp M &kp I &kp N &kp A
                        &macro_wait_time 300 &kp L &kp RET>;
        };
        sudo_bang_macro: sudo_bang_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp S &kp U &kp D &kp O &kp SPACE
                        &kp EXCL &kp EXCL &kp RET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

// DEFAULT
// Encoder: rotate = volume down/up, press = play/pause
// ------------------------------------------------------------------------------------------------------------
// | ESC   |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |  BSPC  || KNOB: PLAY/PAUSE
// | TAB    |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   \   |
// | FN      |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |   ENTER   || DEL      | PGUP |
// | LSHIFT    |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  | RSHIFT |  UP  || END/HOME | PGDN |
// | LCTRL | LGUI | LALT |      SPACE (hold = FN)      | RALT |  FN  | LEADER |      LEFT   |   DOWN   | RGHT |
// ------------------------------------------------------------------------------------------------------------

        default_layer {
            display-name = "Base";
            bindings = <
    &kp ESC    &kp N1    &kp N2    &kp N3     &kp N4    &kp N5   &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC  &kp C_PLAY_PAUSE
    &kp TAB    &kp Q     &kp W     &kp E      &kp R     &kp T    &kp Y      &kp U     &kp I      &kp O      &kp P     &kp LBKT   &kp RBKT   &kp BSLH
    &mo FN     &kp A     &kp S     &kp D      &kp F     &kp G    &kp H      &kp J     &kp K      &kp L      &kp SEMI  &kp SQT    &kp RET    &kp DEL   &kp PG_UP
    &kp LSHFT  &kp Z     &kp X     &kp C      &kp V     &kp B    &kp N      &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT  &kp UP     &td0      &kp PG_DN
    &kp LCTRL  &kp LGUI  &kp LALT  &lt FN SPACE  &kp RALT  &mo FN  &leader   &kp LEFT  &kp DOWN   &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

// FN
// Encoder: rotate = up/down arrows, press = ZMK Studio unlock
// ------------------------------------------------------------------------------------------------------------
// |  `    | F1  | F2  | F3  | F4  | F5  | F6  | F7  | F8  | F9  | F10 | F11 | F12 |        || KNOB: UNLOCK
// | NUMPAD | BT0 | BT1 | BT2 |     |     |BSPC |BSPC | UP  | DEL | DEL |     | INS | PRTSC |
// |         |     |     |     |     |     |HOME |LEFT |DOWN |RGHT | END |     |           ||          | NEXT |
// |           |PAUSE|     |     |     |     |     |     |     |     |     |        |      || HOME     | PREV |
// |       |      |      |                             |      |      | RCTRL |       HOME   |          | END  |
// ------------------------------------------------------------------------------------------------------------

        fn_layer {
            display-name = "Fn";
            bindings = <
    &kp GRAVE  &kp F1           &kp F2        &kp F3        &kp F4    &kp F5  &kp F6      &kp F7      &kp F8    &kp F9     &kp F10   &kp F11  &kp F12     &trans    &studio_unlock
    &to NUMPAD &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &trans    &trans  &kp BSPC    &kp BSPC    &kp UP    &kp DELETE &kp DELETE &trans  &kp INSERT  &kp PRINTSCREEN
    &trans     &trans           &trans        &trans        &trans    &trans  &kp HOME    &kp LEFT    &kp DOWN  &kp RIGHT  &kp END   &trans   &trans      &trans    &kp C_NEXT
    &trans     &kp PAUSE_BREAK  &trans        &trans        &trans    &trans  &trans      &trans      &trans    &trans     &trans    &trans   &trans      &kp HOME  &kp C_PREV
    &trans     &trans           &trans        &trans        &trans    &trans  &kp RCTRL   &kp HOME    &trans    &kp END
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

// NUMPAD (toggled on via FN+TAB, off via the FN/CAPS position)
// Encoder: rotate = up/down arrows, press = (transparent)
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |     |     |     |     |     |  /  |  *  | KP- |     |     |        || KNOB:
// |        |     | UP  |     |     |     |     |  7  |  8  |  9  | KP+ |     |BTCLR|       |
// | DEFAULT |LEFT |DOWN |RGHT |     |     |     |  4  |  5  |  6  | KP+ |     |           ||          |      |
// |           |     |     |     |     |     |     |  1  |  2  |  3  |ENTER|        |      ||          |      |
// |       |      |      |                             |  0   |  .   | ENTER |              |          |      |
// ------------------------------------------------------------------------------------------------------------

        numpad_layer {
            display-name = "Numpad";
            bindings = <
    &trans       &trans    &trans    &trans     &trans  &trans   &trans      &trans  &kp FSLH  &kp KP_MULTIPLY  &kp KP_MINUS  &trans  &trans       &trans  &trans
    &trans       &trans    &kp UP    &trans     &trans  &trans   &trans      &kp N7  &kp N8    &kp N9           &kp KP_PLUS   &trans  &bt BT_CLR   &trans
    &to DEFAULT  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans   &trans      &kp N4  &kp N5    &kp N6           &kp KP_PLUS   &trans  &trans       &trans  &trans
    &trans       &trans    &trans    &trans     &trans  &trans   &trans      &kp N1  &kp N2    &kp N3           &kp ENTER     &trans  &trans       &trans  &trans
    &trans       &trans    &trans    &trans     &kp N0  &kp DOT  &kp ENTER   &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

    };
};
